# Database (Postgres for prod or SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./fathom_dev.db

# Fathom SDK
FATHOM_ENDPOINT=http://localhost:8000/api/v1

# Groq AI Integration (Ultra-fast LLM Inference for Trace Diagnosis, Auto-Fix & LLM Judge)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Judge LLM
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=llama-3.3-70b-versatile

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DRIFT_THRESHOLD=0.70
